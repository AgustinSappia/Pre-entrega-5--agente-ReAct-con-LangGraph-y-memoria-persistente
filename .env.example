LLM_PROVIDER=openai
OPENAI_API_KEY=tu-api-key-de-openai-aqui
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ruta del archivo SQLite donde el checkpointer persiste el estado de
# las conversaciones (se crea solo la primera vez que se corre el agente).
SQLITE_DB_PATH=checkpoints.sqlite
